# Worker RUNTIME variables. Configure these in Settings > Variables and Secrets.
# No build variables, Cloudflare account ID, API token or resource UUID needed.
# Secret: generate at least 32 random characters and keep across deployments.
AUTH_HMAC_SECRET=
# Secret: JSON map of AES-256 keys; each value is 32 random bytes in base64.
CREDENTIAL_KEYS=
# Secret: optional administrator API credential, at least 32 random characters.
ADMIN_API_KEY=
# Secret: needed for real email OTP delivery.
MAIL_API_KEY=
# Secret: optional single-account default; prefer api_hash in API requests.
TG_API_HASH=

CREDENTIAL_KEY_ID=v1

# Plaintext runtime variables. Defaults are handled in Worker code.
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=7200
AUTH_STATE_PREFIX=telegram-bot:
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=
PUBLIC_BASE_URL=
TG_API_ID=
TG_PHONE=
TG_BOT_NAME=
TG_BOT_USERNAME=
# Optional local use: copy to .env and run npm run secrets to upload ONLY the
# five Secret fields above. Plaintext fields are configured in the dashboard.

# Runtime production limits; documented bounds are validated by the Worker.
OTP_IP_QPS=1
API_IP_PER_MINUTE=120
API_USER_PER_MINUTE=60
WEBHOOK_IP_PER_MINUTE=1200
TG_LOGIN_PER_TEN_MINUTES=5
TG_CREATE_PER_TEN_MINUTES=10
MAX_TG_ACCOUNTS_PER_USER=5
MAX_BOTS_PER_USER=20
MAX_CHANNELS_PER_USER=50
TELEGRAM_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=240
JOB_QUEUE_LIMIT=20
JOB_RETENTION_SECONDS=604800
WEBHOOK_CHAT_PER_MINUTE=5
WEBHOOK_BOT_PER_MINUTE=300
WEBHOOK_QUEUE_LIMIT=500
WEBHOOK_BATCH_SIZE=10
WEBHOOK_RETENTION_SECONDS=604800
