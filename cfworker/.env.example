# Worker RUNTIME variables. Configure these in Settings > Variables and Secrets.
# No build variables, Cloudflare account ID, API token or resource UUID needed.
# Secret: generate at least 32 random characters and keep across deployments.
AUTH_HMAC_SECRET=
# Secret: needed for real email OTP delivery.
MAIL_API_KEY=
# Secret: optional single-account default; prefer api_hash in API requests.
TG_API_HASH=

# Plaintext runtime variables. Defaults are handled in Worker code.
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=7200
AUTH_STATE_PREFIX=telegram-bot:
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=
PUBLIC_BASE_URL=
TG_API_ID=
TG_PHONE=
TG_BOT_NAME=
TG_BOT_USERNAME=
# Optional local use: copy to .env and run npm run secrets to upload ONLY the
# three Secret fields above. Plaintext fields are configured in the dashboard.
