# Deployment resources; configure writes the non-secret Wrangler config.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_WORKER_NAME=telegram-cfworker-api
CF_D1_DATABASE_NAME=telegram_cfworker
CF_D1_DATABASE_ID=
CF_CPU_MS=30000
# Optional bulk secret provisioning using npm run secrets. Not written to JSON.
AUTH_HMAC_SECRET=
MAIL_API_KEY=
TG_API_HASH=
# Runtime vars (non-secret). Sensitive bindings use wrangler secret put.
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=7200
AUTH_STATE_PREFIX=telegram-bot:
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=
PUBLIC_BASE_URL=
TG_API_ID=
TG_PHONE=
TG_BOT_NAME=
TG_BOT_USERNAME=
