{
  "name": "telegram-cfworker-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply",
    "deploy": "wrangler deploy",
    "probe:telegram": "node --env-file-if-exists=.dev.vars --env-file-if-exists=.env scripts/probe-telegram.js",
    "check": "node --check src/index.js && node --check src/auth-state.js && node --check src/auth-runtime.js && node --check src/store.js && node --check src/schema.js && node --check src/telegram-account.js && node --check src/telegram-socket.js && node --check scripts/probe-telegram.js && node --check scripts/secrets.js",
    "secrets": "node --env-file-if-exists=.env scripts/secrets.js"
  },
  "dependencies": {
    "big-integer": "1.6.52",
    "teleproto": "1.229.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "vite": "8.3.2"
  }
}
