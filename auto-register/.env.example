# Generate once: openssl rand -hex 32; keep stable across service instances.
AUTH_HMAC_SECRET=replace_with_random_secret_at_least_32_characters
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=7200
# Required: administrator is created directly at startup without email verification.
# No default administrator. Existing password is never overwritten on restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin auth: cumulative failures per IP within the ban interval; atomic Redis ban.
ADMIN_AUTH_MAX_FAILURES=2
ADMIN_IP_BAN_SECONDS=3600
# Existing Redis; REDIS_URL takes precedence over individual connection fields.
REDIS_URL=
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=telegram-bot:
# SMTP email delivery. Registration/login cannot finish without email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Compose host port; container PORT defaults to 3100. Both can be omitted.
API_PORT=3100
# Public HTTPS origin for per-bot webhook registration. No path or query.
PUBLIC_BASE_URL=
# SQL engine: mysql (8.0+) or postgresql (16+).
DB_TYPE=mysql
# Inside the API container, localhost refers to the API container itself.
DB_HOST=host.docker.internal
# Empty selects 3306 (mysql) or 5432 (postgresql).
DB_PORT=
# Database name: letters, digits or underscores; MySQL max 64, PostgreSQL max 63.
DB_DATABASE=telegram_bot
# Auto-create needs database creation privileges; use false for a provisioned DB.
DB_AUTO_CREATE_DATABASE=true
# PostgreSQL connection database used only during auto-create.
DB_MAINTENANCE_DATABASE=postgres
# disable for trusted local connections; verify-full verifies server certificate/hostname.
DB_SSL_MODE=disable
# Optional custom CA PEM, with literal \n escapes on one line.
DB_SSL_CA=
# User needs schema DDL privileges and SELECT/INSERT/UPDATE/DELETE on DB_DATABASE.
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
# Standalone create-bot script defaults. API requires user App credentials or app_config_id.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_BOT_NAME=
TG_BOT_USERNAME=

# Runtime AES-256-GCM keyring. Generate 32 random bytes per version. Required.
CREDENTIAL_KEYS=
CREDENTIAL_KEY_ID=v1
# Optional administrator API credential, independent of platform tokens.
ADMIN_API_KEY=

# Runtime safety, quotas and durable queues. OTP cooldown is fixed at 60s.
OTP_IP_QPS=1
API_IP_PER_MINUTE=120
API_USER_PER_MINUTE=60
WEBHOOK_IP_PER_MINUTE=1200
TG_LOGIN_PER_TEN_MINUTES=5
TG_CREATE_PER_TEN_MINUTES=10
MAX_TG_ACCOUNTS_PER_USER=5
MAX_BOTS_PER_USER=20
MAX_CHANNELS_PER_USER=50
MAX_TG_APPS_PER_USER=5
MAX_PROJECTS_PER_USER=10
MAX_ACTIVE_WORKFLOWS_PER_USER=2
BUSINESS_EVENT_RETENTION_DAYS=90
# 0 disables retaining raw Telegram updates; event summaries remain available.
RAW_UPDATE_RETENTION_DAYS=7
TRACKING_LINK_TTL_SECONDS=86400
TELEGRAM_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=240
JOB_QUEUE_LIMIT=20
JOB_RETENTION_SECONDS=604800
WEBHOOK_CHAT_PER_MINUTE=5
WEBHOOK_BOT_PER_MINUTE=300
WEBHOOK_QUEUE_LIMIT=500
WEBHOOK_RETENTION_SECONDS=604800
QUEUE_POLL_INTERVAL_MS=1000
TRUST_PROXY_HOPS=0
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=5000
