# 在仓库根目录加载：set -a; source scripts/create-bot.env; set +a
# 仅 source 自己填写的可信文件，此文件按 Bash 语法执行。
TG_API_ID=replace_with_app_api_id
TG_API_HASH=replace_with_app_api_hash
TG_PHONE='+8613800000000'
TG_BOT_NAME='Gatherstar Card Bot'
TG_BOT_USERNAME=gatherstar_unique_card_bot
TG_SESSION_PATH=scripts/.telegram-user.session
TG_TOKEN_FILE=scripts/.bot-token.env
# 可选认证变量，建议运行时临时注入，不长期保存验证码
# TG_PHONE_CODE=
# TG_PASSWORD=
